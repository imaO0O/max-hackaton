# Скопируйте файл в .env и заполните значения. Файл .env не коммитится.

# Токен чат-бота с платформы MAX для партнёров (выдают организаторы хакатона).
BOT_TOKEN=

# Запускать ли бота (long polling) и планировщик напоминаний в этом процессе.
BOT_ENABLED=true

# Никнейм бота без @. Если не указан, берётся из Bot API при старте.
BOT_USERNAME=

# HTTP-сервер: API (/api) и собранное мини-приложение (/).
HOST=0.0.0.0
PORT=8080

# Файл базы SQLite. В Docker лежит в томе storage.
DATABASE_PATH=./storage/posle9.sqlite

# Учебный год плана в формате 2026/2027. Пусто — определяется по текущей дате.
ACADEMIC_YEAR=

# Как часто планировщик проверяет напоминания, в секундах.
REMINDER_INTERVAL_SECONDS=300

# Срок жизни подписи initData мини-приложения, в секундах.
INIT_DATA_MAX_AGE_SECONDS=86400

# Только для локальной разработки вне MAX: пускать запросы с заголовком X-Dev-User-Id.
# В production (NODE_ENV=production) игнорируется.
AUTH_DEV_BYPASS=false

LOG_LEVEL=info
